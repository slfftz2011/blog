- const { effect, source, sub, typed_option } = theme.subtitle
- let subContent = sub || new Array()

script.
  function isChinese(char) {
    return /\p{Script=Han}/u.test(char);
  }
  function customTypewriter(element, strings, options) {
    let currentStringIndex = 0;
    let currentCharIndex = 0;
    let isTyping = true;
    let isBackspacing = false;
    let timeoutId;
    const type = () => {
      const currentString = strings[currentStringIndex];
      if (isTyping) {
        if (currentCharIndex < currentString.length) {
          const char = currentString[currentCharIndex];
          element.textContent += char;
          currentCharIndex++;
          const delay = isChinese(char) ? options.typeSpeed : options.typeSpeed / 2;
          timeoutId = setTimeout(type, delay);
        } else {
          isTyping = false;
          isBackspacing = true;
          timeoutId = setTimeout(type, options.backDelay || 1000);
        }
      } else if (isBackspacing) {
        if (currentCharIndex > 0) {
          const charToDelete = strings[currentStringIndex][currentCharIndex - 1];
          element.textContent = element.textContent.slice(0, -1);
          currentCharIndex--;
          const backDelay = isChinese(charToDelete) ? options.backSpeed : options.backSpeed / 2;
          timeoutId = setTimeout(type, backDelay);
        } else {
          isBackspacing = false;
          currentStringIndex = (currentStringIndex + 1) % strings.length;
          timeoutId = setTimeout(type, options.startDelay);
          isTyping = true;
        }
      }
    };
    timeoutId = setTimeout(type, options.startDelay);
    return {
      destroy: () => {
        clearTimeout(timeoutId);
      }
    };
  }
  window.typedJSFn = {
      init: str => {
          window.typed = customTypewriter(document.getElementById('subtitle'), str, {
              startDelay: 300,
              typeSpeed: 150,
              backSpeed: 50,
              backDelay: 1000,
          })
      },
    run: subtitleType => {
      if (!{effect}) {
        if (typeof Typed === 'function') {
          subtitleType()
        } else {
          btf.getScript('!{url_for(theme.asset.typed)}').then(subtitleType)
        }
      } else {
        subtitleType()
      }
    },
    processSubtitle: (content, extraContents = []) => {
      if (!{effect}) {
        const sub = !{JSON.stringify(subContent)}.slice()

        if (extraContents.length > 0) {
          sub.unshift(...extraContents)
        }

        if (typeof content === 'string') {
          sub.unshift(content)
        } else if (Array.isArray(content)) {
          sub.unshift(...content)
        }

        sub.length > 0 && typedJSFn.init(sub)
      } else {
        document.getElementById('subtitle').textContent = typeof content === 'string' ? content :
          (Array.isArray(content) && content.length > 0 ? content[0] : '')
      }
    }
  }
  btf.addGlobalFn('pjaxSendOnce', () => { typed.destroy() }, 'typedDestroy')

case source
  when 1
    script.
      function subtitleType () {
        fetch('https://v1.hitokoto.cn')
          .then(response => response.json())
          .then(data => {
            const from = '出自 ' + data.from
            typedJSFn.processSubtitle(data.hitokoto, [from])
          })
          .catch(err => {
            console.error('Failed to get the Hitokoto API:', err)
            typedJSFn.processSubtitle(!{JSON.stringify(subContent)})
          })
      }
      typedJSFn.run(subtitleType)

  when 2
    script.
      function subtitleType () {
        fetch('https://v.api.aa1.cn/api/yiyan/index.php')
          .then(response => response.text())
          .then(data => {
            const reg = /<p>(.*?)<\/p>/g
            const result = reg.exec(data)
            if (result && result[1]) {
              typedJSFn.processSubtitle(result[1])
            } else {
              throw new Error('Failed to parse the return value of the Yiyan API')
            }
          })
          .catch(err => {
            console.error('Failed to get the Yiyan API:', err)
            typedJSFn.processSubtitle(!{JSON.stringify(subContent.length)})
          })
      }
      typedJSFn.run(subtitleType)

  when 3
    script.
      function subtitleType () {
        btf.getScript('https://sdk.jinrishici.com/v2/browser/jinrishici.js')
          .then(() => {
            jinrishici.load(result => {
              if (result && result.data && result.data.content) {
                typedJSFn.processSubtitle(result.data.content)
              } else {
                throw new Error('Failed to parse the return value of Jinrishici API')
              }
            })
          })
          .catch(err => {
            console.error('Failed to get the Jinrishici API:', err)
            typedJSFn.processSubtitle(!{JSON.stringify(subContent.length)})
          })
      }
      typedJSFn.run(subtitleType)

  default
      script.
          function isChinese(char) {
            return /\p{Script=Han}/u.test(char);
          }
          function customTypewriter(element, strings, options) {
            let currentStringIndex = 0;
            let currentCharIndex = 0;
            let isTyping = true;
            let isBackspacing = false;
            let timeoutId;
            const type = () => {
              const currentString = strings[currentStringIndex];
              if (isTyping) {
                if (currentCharIndex < currentString.length) {
                  const char = currentString[currentCharIndex];
                  element.textContent += char;
                  currentCharIndex++;
                  const delay = isChinese(char) ? options.typeSpeed : options.typeSpeed / 1.5;
                  timeoutId = setTimeout(type, delay);
                } else {
                  isTyping = false;
                  isBackspacing = true;
                  timeoutId = setTimeout(type, options.backDelay || 1000);
                }
              } else if (isBackspacing) {
                if (currentCharIndex > 0) {
                  element.textContent = element.textContent.slice(0, -1);
                  currentCharIndex--;
                  timeoutId = setTimeout(type, options.backSpeed);
                } else {
                  isBackspacing = false;
                  currentStringIndex = (currentStringIndex + 1) % strings.length;
                  timeoutId = setTimeout(type, options.startDelay);
                  isTyping = true;
                }
              }
            };
            timeoutId = setTimeout(type, options.startDelay);
            return {
              destroy: () => {
                clearTimeout(timeoutId);
              }
            };
          }
          // 获取默认内容作为后备
          const defaultQuote = "咦？！我的语录文件好像跑丢了？".split(',');
          const subtitlePath = GLOBAL_CONFIG.root + 'subtitle.json';
          // 页面加载完成后执行
          document.addEventListener('DOMContentLoaded', function () {
              // 尝试从 subtitle.json 获取内容
              fetch(subtitlePath)
                  .then(response => {
                      // 检查响应是否成功
                      if (!response.ok) {
                          throw new Error(`HTTP error! status: ${response.status}`);
                      }
                      return response.json();
                  })
                  .then(quotes => {
                      console.log('自定义语录加载成功！');
                      // 成功时，使用获取到的语录启动打字机
                      startTypingEffect(quotes);
                  })
                  .catch(error => {
                      console.warn('自定义语录加载失败，将使用默认语录。', error);
                      // 失败时，使用默认语录启动打字机
                      startTypingEffect(defaultQuote);
                  });
          });

          // 显示语录的函数
          /**
           * 启动打字机效果
           * @param {Array<string>} quotes - 要显示的语录数组
           */
          function startTypingEffect(quotes) {
              // 确保 quotes 是一个数组，如果不是则包装成数组
              const quoteList = Array.isArray(quotes) ? quotes : [quotes];

              // 定义初始化打字机的逻辑
              const initTyped = () => {
                  // 如果已有打字机实例，先销毁
                  if (window.typed) {
                      window.typed.destroy();
                  }

                  // 初始化新的打字机实例
                  window.typed = customTypewriter(document.getElementById('subtitle'), quoteList, {
                      startDelay: 300,
                      typeSpeed: 150,
                      backSpeed: 50,
                      backDelay: 1000,
                  });
              };

              // 直接调用 initTyped，无需检查 Typed.js
              initTyped();
          }
